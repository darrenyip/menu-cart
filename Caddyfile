https://institute.gmgsyy.com {
	handle {
		root * /home/ubuntu/frontend/ortho-institute/dist
		encode gzip
		header {
			Cache-Control "public, max-age=36000"
		}
		file_server
		try_files {path} /index.html
	}
	handle /api/* {
		reverse_proxy localhost:3000
	}
}

