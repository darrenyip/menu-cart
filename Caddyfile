https://ruan-menu-screen.gmgsyy.com {
	@static {
		file
		path *.ttf *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.woff
	}
	handle @static {
		root * /home/ubuntu/frontend/ruanMenuScreen/dist
		header Cache-Control "public, max-age=5184000, immutable"
		header X-Static-Matched "true"
		file_server
	}
	handle {
		root * /home/ubuntu/frontend/ruanMenuScreen/dist
		encode gzip zstd
		header Cache-Control "public, max-age=36000"
		file_server
		try_files {path} /index.html
	}
}

